# Local stack configuration for infra/docker-compose.yml.
#
#   cp infra/.env.example infra/.env   # then replace every value
#
# infra/.env is gitignored. Compose loads it automatically because it sits next to
# the compose file. Every variable below is required: compose refuses to start if
# one is missing, rather than silently booting with an empty password.
#
# Avoid `$` in values — compose treats it as variable interpolation.

# Optional overrides — read by chainrisk.settings (src/chainrisk/settings.py), ignored by
# compose. Defaults match the host ports in docker-compose.yml:
#   KAFKA_HOST / KAFKA_PORT                          localhost / 19092
#   SCHEMA_REGISTRY_HOST / SCHEMA_REGISTRY_PORT      localhost / 18081
#   MINIO_HOST / MINIO_PORT                          localhost / 9000
#   POSTGRES_OPS_HOST / POSTGRES_OPS_PORT            localhost / 5433
#   AWS_REGION                                       us-east-1

# ── MinIO (local S3 stand-in) ────────────────────────────────────
# Root credentials for the S3 API (:9000) and console (:9001).
# MinIO rejects passwords shorter than 8 characters.
MINIO_ROOT_USER=chainrisk-admin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# ── Postgres (operational DB: watchlists, alert rules, annotations) ──
# Host port 5433. Debezium will connect with these in Phase 5.
POSTGRES_OPS_USER=chainrisk
POSTGRES_OPS_PASSWORD=change-me
POSTGRES_OPS_DB=chainrisk_ops
